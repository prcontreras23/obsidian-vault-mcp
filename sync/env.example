# Copia este archivo a sync/.env — o mejor, deja que `npm run setup` lo escriba.
# sync/.env trae un secreto: nunca lo subas a un repositorio.

# La carpeta del vault de Obsidian que quieres poder leer desde el celular.
VAULT_PATH=/ruta/completa/a/tu/vault

# --- Destino: elige UNA de las dos formas ---

# Forma A (la que usa el instalador): subir por el endpoint del Worker.
WORKER_URL=https://obsidian-vault-mcp.tu-subdominio.workers.dev
SYNC_SECRET=

# Forma B: subir directo a la API de D1. Si defines estas tres, se usa esta y
# el Worker queda de solo lectura absoluto (el endpoint /sync ni se toca).
# El token necesita permiso «D1: Edit» y se crea en el panel de Cloudflare.
# CF_ACCOUNT_ID=
# CF_D1_DATABASE_ID=
# CF_API_TOKEN=

# --- Opcional ---

# Carpetas que NO quieres que salgan de esta computadora, separadas por coma.
# Se comparan como prefijo de la ruta relativa dentro del vault.
#   EXCLUDE_PREFIXES=Privado/,Trabajo/confidencial/
EXCLUDE_PREFIXES=
